{
  "name": "feature-roadmap-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Feature Request & Public Roadmap Portal (MERN)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run server",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "smoke": "npm run smoke:phase6 --workspace=server",
    "smoke:all": "npm run smoke:phase1 --workspace=server && npm run smoke:phase2 --workspace=server && npm run smoke:phase3 --workspace=server && npm run smoke:phase4 --workspace=server && npm run smoke:phase5 --workspace=server && npm run smoke:phase6 --workspace=server",
    "smoke:phase1": "npm run smoke:phase1 --workspace=server",
    "smoke:phase2": "npm run smoke:phase2 --workspace=server",
    "smoke:phase3": "npm run smoke:phase3 --workspace=server",
    "smoke:phase4": "npm run smoke:phase4 --workspace=server",
    "smoke:phase5": "npm run smoke:phase5 --workspace=server",
    "smoke:phase6": "npm run smoke:phase6 --workspace=server",
    "seed": "npm run seed --workspace=server",
    "seed:reset": "npm run seed:reset --workspace=server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.26.1"
  }
}
